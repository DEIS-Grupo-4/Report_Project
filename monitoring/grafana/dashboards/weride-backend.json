{
  "title": "WeRide - Backend (Render)",
  "uid": "weride-backend",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Disponibilidad (/health = UP)",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "probe_success{job=\"weride-backend-health\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {
        "mappings": [{"type": "value", "options": {"0": {"text": "CAÍDO", "color": "red"}, "1": {"text": "UP", "color": "green"}}}],
        "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 2, "type": "stat", "title": "Código HTTP",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "probe_http_status_code{job=\"weride-backend-health\"}", "refId": "A"}]
    },
    {
      "id": 3, "type": "stat", "title": "Tiempo de respuesta actual",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "probe_duration_seconds{job=\"weride-backend-health\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s",
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 2}, {"color": "red", "value": 5}]}}}
    },
    {
      "id": 4, "type": "stat", "title": "Días para vencer el certificado TLS",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "(probe_ssl_earliest_cert_expiry{job=\"weride-backend-health\"} - time()) / 86400", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "d", "decimals": 0}}
    },
    {
      "id": 5, "type": "timeseries", "title": "Tiempo de respuesta de /health (umbral EXP-04: 5 s)",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "probe_duration_seconds{job=\"weride-backend-health\"}", "legendFormat": "duración total", "refId": "A"},
                  {"expr": "probe_http_duration_seconds{job=\"weride-backend-health\", phase=\"processing\"}", "legendFormat": "procesamiento ({{phase}})", "refId": "B"}],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"thresholdsStyle": {"mode": "line"}},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 5}]}}}
    },
    {
      "id": 6, "type": "timeseries", "title": "Disponibilidad en el tiempo",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 15},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "probe_success{job=\"weride-backend-health\"}", "legendFormat": "probe_success", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1}}
    }
  ]
}
